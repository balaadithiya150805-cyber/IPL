{
  "name": "ipl-auction-app",
  "version": "1.0.0",
  "description": "Real-Time Multiplayer IPL Mock Auction Web Application",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,yellow.bold\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "ipl",
    "mock-auction",
    "cricket",
    "socket.io",
    "react",
    "express",
    "real-time"
  ],
  "author": "",
  "license": "MIT"
}
