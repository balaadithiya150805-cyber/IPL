# MongoDB connection string used to persist auction rooms and results.
# Replace this placeholder with your MongoDB Atlas connection string locally
# or configure MONGO_URI as a secret in Render.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Port used by the Express and Socket.IO server.
PORT=5000

# Public URL of the deployed frontend, used by Express and Socket.IO CORS.
FRONTEND_URL=http://localhost:5173